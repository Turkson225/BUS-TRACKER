{
  "name": "onroute-bus-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-auth.mjs && node scripts/check-manual-deployment.mjs && node scripts/check-postgres.mjs && node scripts/check-worker.mjs && node scripts/check-alerts.mjs && node scripts/check-recorded-alerts.mjs && node scripts/check-email-relay.mjs && node scripts/check-pages.mjs",
    "db:generate": "node scripts/generate-database.mjs --check",
    "manual:generate": "node scripts/generate-manual-deployment.mjs",
    "manual:check": "node scripts/generate-manual-deployment.mjs --check"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
